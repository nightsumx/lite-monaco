{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "noEmit": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // src/react 按包名 import 'lite-monaco'(发布后就是用户装的那一份);仓库里指回源码
    "paths": { "lite-monaco": ["./src/index.ts"] }
  },
  "include": ["src", "__tests__"],
  "exclude": ["dist", "node_modules", "poc"]
}
